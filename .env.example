MONGODB_URI=
MONGODB_DATABASE=proofflow_dev
NEXT_PUBLIC_API_URL=http://localhost:8000
API_SECRET_KEY=
ENVIRONMENT=development

# ML Model & Runtime Configuration
MODEL_NAME=microsoft/deberta-v3-base
MODEL_VERSION=1.0.0
MODEL_PATH=ml/checkpoints/deberta_v3_event
MODEL_DEVICE=cuda
ML_ENVIRONMENT=development

# Authentication & JWT Verification (Clerk / OIDC)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Development Auth Bypass: STRICTLY DEFAULT FALSE.
# Only permitted in explicitly configured 'development' or 'test' environments.
# Setting to 'true' in staging, production, or unknown/unset environments will fail application startup.
ALLOW_DEV_AUTH_BYPASS=false
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_JWKS_TIMEOUT_SECONDS=10

# API Rate Limiting (In-memory sliding window per user identity)
# Note: In-memory limits are process-local; multi-replica production deployments require a distributed store (e.g. Redis).
RATE_LIMIT_EVIDENCE_UPLOAD_PER_MINUTE=30
RATE_LIMIT_DOSSIER_PDF_PER_MINUTE=10
# Comma-separated list of trusted reverse proxy IPs permitted to forward client IP headers
TRUSTED_PROXIES=

