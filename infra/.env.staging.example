# ==============================================================================
# ProofFlow Staging Environment Configuration Template
# COPY THIS FILE TO 'infra/.env.staging' ON YOUR STAGING HOST
# NEVER COMMIT '.env.staging' OR REAL SECRETS TO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Environment & FastAPI Configuration
# ------------------------------------------------------------------------------
# Strictly 'staging' to enforce security hardening and fail-closed auth checks
ENVIRONMENT=staging
SERVICE_NAME="ProofFlow API"
SERVICE_VERSION="0.1.0"

# Must be a cryptographically secure random string (minimum 32 characters)
# Generate via: openssl rand -hex 32
API_SECRET_KEY=REPLACE_WITH_GENERATED_32_BYTE_HEX_KEY

# ------------------------------------------------------------------------------
# Database Connection (MongoDB Atlas Staging Cluster)
# ------------------------------------------------------------------------------
# Obtain from MongoDB Atlas Dashboard -> Connect -> Drivers (Python Async)
# Format: mongodb+srv://<username>:<password>@<staging-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=REPLACE_WITH_MONGODB_ATLAS_STAGING_URI
MONGODB_DATABASE=proofflow_staging
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# The public HTTPS URL where your frontend staging app is hosted
# Example: https://staging.proofflow.example.com
CORS_ORIGINS=REPLACE_WITH_STAGING_FRONTEND_HTTPS_URL

# The public HTTPS URL where your backend staging API is reachable by the browser
NEXT_PUBLIC_API_URL=REPLACE_WITH_STAGING_API_HTTPS_URL

# ------------------------------------------------------------------------------
# Authentication (Clerk Staging Instance)
# ------------------------------------------------------------------------------
# Obtain from Clerk Dashboard (https://dashboard.clerk.com) -> API Keys & JWT Templates
# Backend JWT Verification Settings:
CLERK_ISSUER=REPLACE_WITH_CLERK_STAGING_ISSUER_URL
CLERK_JWKS_URL=REPLACE_WITH_CLERK_STAGING_JWKS_URL
CLERK_AUDIENCE=
# Set to your frontend staging origin (must match the 'azp' claim in Clerk session tokens)
CLERK_AUTHORIZED_PARTIES=REPLACE_WITH_STAGING_FRONTEND_HTTPS_URL

# FAIL-CLOSED DEV AUTH BYPASS:
# Strictly MUST be 'false' in staging. Setting 'true' in staging crashes container startup.
ALLOW_DEV_AUTH_BYPASS=false
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_JWKS_TIMEOUT_SECONDS=10

# Frontend Clerk SDK Keys (from Clerk Dashboard -> API Keys):
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/cases
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/cases

# ------------------------------------------------------------------------------
# Reverse Proxy & Rate Limiting Settings
# ------------------------------------------------------------------------------
RATE_LIMIT_EVIDENCE_UPLOAD_PER_MINUTE=30
RATE_LIMIT_DOSSIER_PDF_PER_MINUTE=10

# Comma-separated list of trusted reverse proxy IPs permitted to forward client IP headers
# Leave empty if the container is directly exposed or if proxy is on the same local loopback (127.0.0.1)
TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# Persistent Storage Mount Paths
# ------------------------------------------------------------------------------
# Paths inside the container
EVIDENCE_STORAGE_DIR=/app/storage/evidence
TEMP_STORAGE_DIR=/app/storage/temp
MAX_EVIDENCE_FILE_SIZE_BYTES=26214400
